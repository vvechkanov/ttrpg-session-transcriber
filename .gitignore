# Generated by installer — do not commit
venv/
tools/
__pycache__/
*.pyc

# Runtime logs
_run_whisperx_gui.log
app_run.log

# User data — only the project-root speaker_map (legacy location).
# Bare ``speaker_map.json`` would also match in-repo fixtures
# (tests/fixtures/e2e_p2/session/speaker_map.json), which broke CI
# after a fresh checkout.
/speaker_map.json
# Claude Code. The hook registration is the project's, not the machine's:
# without it in the repository a fresh clone and a cloud session run
# neither hook (scripts/precommit_gate.py, scripts/test_edit_reminder.py).
# Everything else under .claude/ is local state — personal overrides,
# worktrees, agent definitions — and stays out.
.claude/*
!.claude/settings.json

# Python packaging build artifacts (pip install -e . / python -m build)
build/
dist/
*.egg-info/

# Test output
Тестовое/

# Launcher build artifacts
launcher/dist/
launcher/build/
launcher/*.zip
*.exe

# PyInstaller
*.spec.bak

# Design handoff bundle — canonical copy lives in docs/handoff/ (markdown).
# Root-level handoff/ was the extraction target for the now-deleted zip; keep
# the path ignored so any local re-extraction does not sneak into commits.
/handoff/

# E2E fixture generation artifacts (canonical baseline is expected_merged.txt)
tests/fixtures/e2e_p2/session/merged.txt
tests/fixtures/e2e_p2/session/transcripts/
tests/fixtures/e2e_p2/session/merged_tier2_test.txt
tests/fixtures/e2e_p2/session/merged_tier2_format_test.txt
